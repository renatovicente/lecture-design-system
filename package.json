{
  "name": "aula-usp",
  "version": "0.1.0",
  "description": "Design system de aulas em HTML para a USP, usado com Claude e GPT.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs",
    "tokens": "node build/tokens.mjs",
    "fontes": "node build/fontes.mjs",
    "marcas": "node build/marcas.mjs",
    "fontes:css": "node build/fontes-css.mjs",
    "servir": "node bin/aula-usp.mjs servir",
    "test:integracao": "node --test tests/integracao/*.test.mjs"
  },
  "devDependencies": {
    "linkedom": "^0.18.13",
    "playwright-core": "^1.63.0"
  },
  "bin": {
    "aula-usp": "bin/aula-usp.mjs"
  },
  "dependencies": {
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "@shikijs/primitive": "4.4.3",
    "katex": "0.18.7"
  }
}

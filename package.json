{
  "name": "aula-usp",
  "version": "0.1.0",
  "description": "Design system de aulas em HTML para a USP, usado com Claude e GPT.",
  "type": "module",
  "files": [
    "bin/",
    "build/",
    "montar/",
    "motor/",
    "componentes/",
    "validador/",
    "contrato/",
    "tokens/",
    "estilos/",
    "assets/",
    "dist/",
    "modelos/",
    "exemplos/",
    "guia/",
    "README.md",
    "!exemplos/*/dist/",
    "!modelos/*/dist/"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs",
    "tokens": "node build/tokens.mjs",
    "fontes": "node build/fontes.mjs",
    "marcas": "node build/marcas.mjs",
    "fontes:css": "node build/fontes-css.mjs",
    "mplstyle": "node build/mplstyle.mjs",
    "guia": "node build/guia.mjs",
    "servir": "node bin/aula-usp.mjs servir",
    "test:integracao": "node --test tests/integracao/*.test.mjs"
  },
  "bin": {
    "aula-usp": "bin/aula-usp.mjs"
  },
  "dependencies": {
    "@hpcc-js/wasm-graphviz": "1.29.1",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "@shikijs/primitive": "4.4.3",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "katex": "0.18.7",
    "linkedom": "^0.18.13",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fontkit": "^2.0.4",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  }
}
